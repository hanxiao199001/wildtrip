# Wildtrip Flask 后端服务
# 放在 /etc/systemd/system/wildtrip-backend.service

[Unit]
Description=Wildtrip Flask Backend API
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/wildtrip-backend
Environment="PATH=/usr/bin:/usr/local/bin"

# 使用 Gunicorn（推荐）
ExecStart=/usr/local/bin/gunicorn -w 4 -b 127.0.0.1:5000 app:app

# 或者直接用 Python（测试用）
# ExecStart=/usr/bin/python3 app.py

Restart=always
RestartSec=10

# 日志
StandardOutput=append:/var/log/wildtrip-backend.log
StandardError=append:/var/log/wildtrip-backend-error.log

[Install]
WantedBy=multi-user.target
