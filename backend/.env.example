# 野游记 WildTrip 配置文件模板
# 复制此文件为 .env 并填入真实配置

# ========================================
# AI模型配置
# ========================================
# Qwen API Key（必填）
AI_API_KEY=your_qwen_api_key_here
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen3-max

# ========================================
# 聚推客联盟配置（美团 CPS 返佣）
# ========================================
# 在聚推客后台 → 个人中心获取 apikey
JUTUIKE_APIKEY=your_jutuike_apikey_here
# 渠道标识（用于追踪订单归属）
JUTUIKE_SID=123456
# 活动ID：27=吃喝玩乐每日福利(最高15%), 36=玩乐变美(4.1%)
JUTUIKE_ACT_ID=27

# ========================================
# 旧美团联盟配置（已废弃，改用聚推客）
# ========================================
# MEITUAN_APP_KEY=your_meituan_app_key
# MEITUAN_SID=001
# MEITUAN_API_VERSION=v1
# MEITUAN_API_QUOTA=2000

# ========================================
# 微信小程序配置（生成小程序码需要）
# ========================================
# 在微信公众平台 → 开发管理 → 开发设置中获取
WECHAT_APPID=your_wechat_appid_here
WECHAT_SECRET=your_wechat_secret_here

# ========================================
# 服务器配置
# ========================================
PORT=5000
DEBUG=False

# ========================================
# 其他配置
# ========================================
# 日志级别（DEBUG/INFO/WARNING/ERROR）
LOG_LEVEL=INFO
