# 野游记 WildTrip 配置文件模板
# 复制此文件为 .env 并填入真实配置

# ========================================
# AI模型配置
# ========================================
# DeepSeek API Key（必填）
AI_API_KEY=your_deepseek_api_key_here
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# ========================================
# 美团联盟配置（可选）
# ========================================
MEITUAN_APP_KEY=your_meituan_app_key
MEITUAN_SID=001
MEITUAN_API_VERSION=v1
MEITUAN_API_QUOTA=2000

# ========================================
# 服务器配置
# ========================================
PORT=5000
DEBUG=False

# ========================================
# 其他配置
# ========================================
# 日志级别（DEBUG/INFO/WARNING/ERROR）
LOG_LEVEL=INFO
