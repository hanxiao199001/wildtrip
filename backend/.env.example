# 野游记 AI 配置示例

# ============================================
# 通义千问 (Qwen) 配置
# ============================================
AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-plus

# 可选模型：
# - qwen-turbo (便宜、快速)
# - qwen-plus (推荐、性价比高)
# - qwen-max (最强、最贵)

# ============================================
# DeepSeek 配置（备用）
# ============================================
# AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-chat

# ============================================
# 微信公众号配置
# ============================================
WECHAT_TOKEN=wildtrip_saas_token
WECHAT_APPID=wx...
WECHAT_SECRET=...

# ============================================
# 数据库配置
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/wildtrip_saas
