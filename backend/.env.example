# 野游记 WildTrip 环境变量配置模板
# 复制此文件为 .env 并填写实际值

# =====================================================
# 💰 微信支付配置
# =====================================================

# 微信小程序
WECHAT_APPID=wxXXXXXXXXXXXXXXXX
WECHAT_SECRET=your_app_secret_here

# 微信商户号(商户号审核通过后填写)
WECHAT_MCHID=1234567890
WECHAT_API_KEY=your_api_key_32_characters_here

# 支付回调地址
PAYMENT_NOTIFY_URL=https://api.wildtrip.com.cn/api/payment/notify

# 是否使用沙箱环境
# true=沙箱测试(开发阶段) | false=生产环境(上线后)
PAYMENT_SANDBOX=true

# 服务器基础URL
SERVER_BASE_URL=https://api.wildtrip.com.cn

# =====================================================
# 🤖 AI模型配置
# =====================================================
AI_API_KEY=sk-xxxx
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-plus

# =====================================================
# 📧 邮件通知配置
# =====================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_app_password
ADMIN_EMAIL=admin@example.com
