# 野游记 WildTrip 环境变量配置模板
# 复制此文件为 .env 并填写实际值
# ⚠️ 不要把真实密钥写进任何会提交到 git 的文件（包括文档）

# =====================================================
# 🔐 应用配置
# =====================================================
# Flask session 密钥（生产环境必须设置为随机值）
FLASK_SECRET_KEY=change_me_to_a_random_string

# 数据库目录（默认 backend/data，一般无需修改）
# DB_DIR=/path/to/data

# =====================================================
# 💬 微信小程序（登录 / 订阅消息用）
# =====================================================
WECHAT_APPID=wxXXXXXXXXXXXXXXXX
WECHAT_SECRET=your_app_secret_here

# 支付功能已下线。重新启用时在微信商户后台重新生成密钥，
# 并补充 WECHAT_MCHID / WECHAT_API_KEY / PAYMENT_NOTIFY_URL 配置。

# 服务器基础URL
SERVER_BASE_URL=https://api.wildtrip.com.cn

# =====================================================
# 🤖 AI模型配置
# =====================================================
AI_API_KEY=sk-xxxx
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-plus

# =====================================================
# 📧 邮件通知配置
# =====================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_app_password
ADMIN_EMAIL=admin@example.com
