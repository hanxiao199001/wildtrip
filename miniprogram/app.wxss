/* 野游记全局样式 - Perplexity薄荷绿风格 */

/* 全局变量 */
page {
  --primary-color: #20B2AA;
  --primary-light: #5FCCC4;
  --primary-dark: #1A8F89;
  --text-primary: #333333;
  --text-secondary: #666666;
  --text-hint: #999999;
  --bg-page: #F5F5F5;
  --bg-card: #FFFFFF;
  --border-color: #E5E5E5;
  --shadow-light: 0 2px 8px rgba(0, 0, 0, 0.08);
  --shadow-card: 0 2px 12px rgba(32, 178, 170, 0.15);
  --radius-small: 8rpx;
  --radius-normal: 16rpx;
  --radius-large: 24rpx;
}

/* 基础样式 */
page {
  background-color: var(--bg-page);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  color: var(--text-primary);
  font-size: 28rpx;
  line-height: 1.6;
}

/* 通用容器 */
.container {
  padding: 32rpx;
}

.page-container {
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 卡片样式 */
.card {
  background: var(--bg-card);
  border-radius: var(--radius-normal);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-light);
}

.card-hover {
  box-shadow: var(--shadow-card);
  transform: translateY(-4rpx);
  transition: all 0.3s ease;
}

/* 按钮样式 */
.btn-primary {
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-light) 100%);
  color: white;
  border-radius: var(--radius-normal);
  padding: 28rpx 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  box-shadow: 0 4px 12px rgba(32, 178, 170, 0.3);
}

.btn-primary:active {
  opacity: 0.9;
  transform: scale(0.98);
}

/* 标题样式 */
.title {
  font-size: 48rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.8;
}

/* 标签样式 */
.tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-small);
  font-size: 24rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.tag-primary {
  background: rgba(32, 178, 170, 0.1);
  color: var(--primary-color);
}

.tag-success {
  background: rgba(52, 199, 89, 0.1);
  color: #34C759;
}

.tag-warning {
  background: rgba(255, 204, 0, 0.1);
  color: #FFCC00;
}

/* 加载动画 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
}

.loading-text {
  margin-left: 20rpx;
  color: var(--text-secondary);
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 120rpx 32rpx;
}

.empty-text {
  color: var(--text-hint);
  font-size: 28rpx;
  margin-top: 24rpx;
}

/* Flex布局 */
.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

/* 间距 */
.mt-small { margin-top: 16rpx; }
.mt-normal { margin-top: 24rpx; }
.mt-large { margin-top: 48rpx; }

.mb-small { margin-bottom: 16rpx; }
.mb-normal { margin-bottom: 24rpx; }
.mb-large { margin-bottom: 48rpx; }

/* 文字颜色 */
.text-primary { color: var(--primary-color); }
.text-secondary { color: var(--text-secondary); }
.text-hint { color: var(--text-hint); }
.text-white { color: white; }

/* 文字大小 */
.text-small { font-size: 24rpx; }
.text-normal { font-size: 28rpx; }
.text-large { font-size: 32rpx; }
.text-xlarge { font-size: 40rpx; }

/* 文字粗细 */
.text-bold { font-weight: 600; }
.text-normal-weight { font-weight: 400; }
