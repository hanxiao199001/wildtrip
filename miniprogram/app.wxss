/**app.wxss**/
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}

.container {
  min-height: 100vh;
}

/* 通用按钮样式 */
button {
  font-size: 28rpx;
}

button::after {
  border: none;
}

/* 通用加载动画 */
@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
