<!--攻略生成页面 — 4阶段流水线-->
<view class="page-container generate-page">

  <!-- 顶部状态 -->
  <view class="status-header">
    <view class="status-emoji" wx:if="{{isFailed}}">❌</view>
    <view class="status-emoji pulse" wx:elif="{{isCompleted}}">🎉</view>
    <view class="status-emoji pulse" wx:else>⏳</view>

    <view class="status-label" wx:if="{{isFailed}}">生成失败</view>
    <view class="status-label" wx:elif="{{isCompleted}}">攻略已生成！</view>
    <view class="status-label" wx:else>{{mode === 'history' ? '正在生成历史人文攻略' : '正在生成攻略'}}</view>
  </view>

  <!-- 进度条 -->
  <view class="bar-wrap" wx:if="{{!isFailed}}">
    <view class="bar-track">
      <view class="bar-fill" style="width: {{progress}}%"></view>
    </view>
  </view>

  <!-- 4 阶段流水线 -->
  <view class="stage-pipeline card" wx:if="{{!isFailed}}">
    <view
      class="stage-item {{currentStage > index ? 'done' : ''}} {{currentStage === index ? 'active' : ''}}"
      wx:for="{{stages}}"
      wx:key="key"
    >
      <!-- 左侧图标 + 竖线 -->
      <view class="stage-left">
        <view class="stage-dot {{currentStage > index ? 'done' : ''}} {{currentStage === index ? 'active' : ''}}">
          <text wx:if="{{currentStage > index}}">✓</text>
          <text wx:else>{{item.icon}}</text>
        </view>
        <view class="stage-line" wx:if="{{index < stages.length - 1}}"></view>
      </view>

      <!-- 右侧文字 -->
      <view class="stage-right">
        <view class="stage-label">{{item.label}}</view>
        <view class="stage-desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <!-- 轮播贴士 -->
  <view class="tip-bar" wx:if="{{!isFailed && !isCompleted}}">
    <view class="tip-icon">💡</view>
    <view class="tip-text">{{currentTip}}</view>
  </view>

  <!-- 查询内容 -->
  <view class="query-display card">
    <view class="query-label">您的需求</view>
    <view class="query-text">{{query}}</view>
  </view>

  <!-- 返现提示 -->
  <view class="cashback-hint card" wx:if="{{!isFailed}}">
    <view class="hint-icon">💰</view>
    <view class="hint-text">预订立省50%，真省钱！</view>
  </view>
</view>
