/* 攻略生成页面样式 */

.generate-page {
  padding: 32rpx;
}

/* 进度卡片 */
.progress-card {
  margin-bottom: 24rpx;
}

.progress-header {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.progress-icon {
  font-size: 64rpx;
  margin-right: 20rpx;
}

.progress-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* 进度条 */
.progress-bar-container {
  margin-bottom: 32rpx;
}

.progress-bar {
  width: 100%;
  height: 16rpx;
  background: #E5E5E5;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary-color) 0%, var(--primary-light) 100%);
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.progress-percent {
  text-align: right;
  font-size: 28rpx;
  color: var(--primary-color);
  font-weight: 600;
}

/* 进度消息 */
.progress-messages {
  max-height: 400rpx;
  overflow-y: auto;
  padding: 24rpx;
  background: #F8F8F8;
  border-radius: var(--radius-normal);
  margin-bottom: 24rpx;
}

.progress-message {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.progress-message:last-child {
  margin-bottom: 0;
}

.message-time {
  color: var(--text-hint);
  margin-right: 12rpx;
  flex-shrink: 0;
}

.message-text {
  color: var(--text-secondary);
  flex: 1;
}

/* 查询显示 */
.query-display {
  padding: 24rpx;
  background: rgba(32, 178, 170, 0.05);
  border-radius: var(--radius-normal);
  border-left: 4rpx solid var(--primary-color);
}

.query-label {
  font-size: 24rpx;
  color: var(--text-hint);
  margin-bottom: 8rpx;
}

.query-text {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.6;
}

/* 速度对比 */
.speed-compare {
  margin-bottom: 24rpx;
}

.compare-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 24rpx;
  text-align: center;
}

.compare-items {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.compare-item {
  flex: 1;
  text-align: center;
  padding: 24rpx;
  border-radius: var(--radius-normal);
  background: #F8F8F8;
}

.compare-item.active {
  background: linear-gradient(135deg, rgba(32, 178, 170, 0.1) 0%, rgba(95, 204, 196, 0.1) 100%);
  border: 2rpx solid var(--primary-color);
}

.compare-label {
  font-size: 24rpx;
  color: var(--text-hint);
  margin-bottom: 12rpx;
}

.compare-time {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.compare-item.active .compare-time {
  color: var(--primary-color);
}

.compare-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.compare-divider {
  font-size: 32rpx;
  color: var(--primary-color);
  font-weight: 600;
  margin: 0 24rpx;
}

/* 返现提示 */
.cashback-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  background: linear-gradient(135deg, rgba(32, 178, 170, 0.1) 0%, rgba(95, 204, 196, 0.1) 100%);
  border: 2rpx solid var(--primary-color);
}

.hint-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.hint-text {
  font-size: 28rpx;
  color: var(--primary-color);
  font-weight: 600;
}
