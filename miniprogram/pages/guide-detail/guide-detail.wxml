<!--攻略详情页 - 精美预览 + 完整内容原生渲染-->
<view class="guide-detail-page">
  <!-- 加载状态 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <view class="loading-text">加载攻略中...</view>
  </view>

  <!-- 攻略内容 -->
  <view wx:if="{{!loading && guide}}">
    <!-- 封面大图区域 -->
    <view class="hero-cover" style="background: {{coverGradient}}">
      <image
        wx:if="{{guide.cover_image && !_coverFailed}}"
        class="hero-cover-img"
        src="{{guide.cover_image}}"
        mode="aspectFill"
        binderror="onCoverError"
      />
      <view class="hero-city" wx:if="{{!guide.cover_image || _coverFailed}}">
        {{guide.destination || '旅行'}}
      </view>
      <view class="hero-overlay"></view>
      <view class="hero-tag" wx:if="{{guide.category}}">{{guide.category}}</view>
    </view>

    <!-- 主信息卡片 -->
    <view class="main-card">
      <view class="main-title">{{guide.title}}</view>
      <view class="meta-row">
        <view class="meta-chip" wx:if="{{guide.destination}}">
          <text class="chip-icon">📍</text>
          <text>{{guide.destination}}</text>
        </view>
        <view class="meta-chip" wx:if="{{guide.days}}">
          <text class="chip-icon">📅</text>
          <text>{{guide.days}}天</text>
        </view>
        <view class="meta-chip" wx:if="{{guide.budget}}">
          <text class="chip-icon">💰</text>
          <text>¥{{guide.budget}}</text>
        </view>
      </view>
      <view class="stats-row">
        <view class="stat-badge" wx:if="{{guide.word_count}}">
          <text class="stat-num">{{wordCountDisplay}}</text>
          <text class="stat-label">字数</text>
        </view>
        <view class="stat-badge" wx:if="{{guide.hotels_count}}">
          <text class="stat-num">{{guide.hotels_count}}</text>
          <text class="stat-label">酒店</text>
        </view>
        <view class="stat-badge" wx:if="{{guide.restaurants_count}}">
          <text class="stat-num">{{guide.restaurants_count}}</text>
          <text class="stat-label">餐厅</text>
        </view>
        <view class="stat-badge" wx:if="{{guide.tickets_count}}">
          <text class="stat-num">{{guide.tickets_count}}</text>
          <text class="stat-label">景点</text>
        </view>
      </view>
    </view>

    <!-- 行程亮点 -->
    <view class="section-card" wx:if="{{highlights.length > 0}}">
      <view class="section-title-bar">
        <text class="section-icon">✨</text>
        <text class="section-title">行程亮点</text>
      </view>
      <view class="highlight-list">
        <view class="highlight-row" wx:for="{{highlights}}" wx:key="day">
          <view class="day-badge">D{{item.day}}</view>
          <text class="highlight-text">{{item.text}}</text>
        </view>
      </view>
    </view>

    <!-- 完整攻略内容（towxml原生渲染）- 精选攻略免费查看 -->
    <view class="section-card content-section" wx:if="{{article}}">
      <view class="section-title-bar">
        <text class="section-icon">📖</text>
        <text class="section-title">完整攻略</text>
      </view>
      <view class="guide-content">
        <towxml nodes="{{article}}" />
      </view>
    </view>

    <!-- 无内容时的提示 -->
    <view class="section-card" wx:if="{{!article && !loading}}">
      <view class="section-title-bar">
        <text class="section-icon">📖</text>
        <text class="section-title">攻略内容</text>
      </view>
      <view class="no-content-tip">
        <text class="no-content-icon">📝</text>
        <text class="no-content-text">攻略内容正在整理中，请稍后再来查看</text>
      </view>
    </view>

    <!-- 攻略特色 -->
    <view class="section-card">
      <view class="section-title-bar">
        <text class="section-icon">🎯</text>
        <text class="section-title">攻略特色</text>
      </view>
      <view class="feature-grid">
        <view class="feature-item">
          <view class="feature-icon-wrap fi-1">🗺️</view>
          <text class="feature-name">详细行程</text>
        </view>
        <view class="feature-item">
          <view class="feature-icon-wrap fi-2">🍜</view>
          <text class="feature-name">本地美食</text>
        </view>
        <view class="feature-item">
          <view class="feature-icon-wrap fi-3">🏨</view>
          <text class="feature-name">住宿推荐</text>
        </view>
        <view class="feature-item">
          <view class="feature-icon-wrap fi-4">💰</view>
          <text class="feature-name">预订返现</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ========== 底部固定栏 ========== -->

  <!-- 底部操作按钮（精选攻略免费，直接展示操作栏） -->
  <view class="bottom-bar action-bar" wx:if="{{!loading && guide}}">
    <view class="action-item" bindtap="onCopy">
      <text class="action-icon">📋</text>
      <text class="action-label">复制</text>
    </view>
    <view class="action-item" bindtap="onToggleFavorite">
      <text class="action-icon">{{guide.is_favorited ? '⭐' : '☆'}}</text>
      <text class="action-label">{{guide.is_favorited ? '已收藏' : '收藏'}}</text>
    </view>
    <button class="action-item share-btn" open-type="share">
      <text class="action-icon">📤</text>
      <text class="action-label">分享</text>
    </button>
    <view class="action-item" bindtap="onGenerateSimilar">
      <text class="action-icon">🚀</text>
      <text class="action-label">同款</text>
    </view>
  </view>

  <!-- 错误状态 -->
  <view class="error-wrap" wx:if="{{!loading && error}}">
    <view class="error-emoji">😢</view>
    <view class="error-msg">{{error}}</view>
    <button class="retry-btn" bindtap="onRetry">重新加载</button>
  </view>
</view>
