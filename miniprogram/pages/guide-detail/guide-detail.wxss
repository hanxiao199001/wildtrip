/* 攻略详情页 - 精美预览 + 完整内容 */

/* 🔥 引入towxml样式（支持Markdown渲染） */
@import "/towxml/style/main.wxss";
@import "/towxml/style/theme/light.wxss";

.guide-detail-page {
  background: #F3F4F6;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ========== 加载状态 ========== */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 300rpx 0;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #E5E7EB;
  border-top-color: #20B2AA;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #9CA3AF;
}

/* ========== 封面大图区域 ========== */
.hero-cover {
  position: relative;
  width: 100%;
  height: 480rpx;
  overflow: hidden;
}

.hero-cover-img {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
}

.hero-city {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: rgba(255, 255, 255, 0.9);
  font-size: 100rpx;
  font-weight: 900;
  text-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.25);
  z-index: 1;
  letter-spacing: 12rpx;
}

.hero-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 200rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.4));
  z-index: 2;
}

.hero-tag {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  background: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(10px);
  color: white;
  font-size: 24rpx;
  font-weight: 600;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  z-index: 3;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

/* ========== 主信息卡片 ========== */
.main-card {
  position: relative;
  z-index: 10;
  margin: -60rpx 24rpx 0;
  background: white;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

.main-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #111827;
  line-height: 1.4;
  margin-bottom: 24rpx;
}

.meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.meta-chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  background: #F0FDFA;
  color: #0D9488;
  font-size: 24rpx;
  font-weight: 600;
  padding: 10rpx 22rpx;
  border-radius: 28rpx;
  border: 1rpx solid #CCFBF1;
}

.chip-icon {
  font-size: 22rpx;
}

/* 统计数据行 */
.stats-row {
  display: flex;
  justify-content: space-around;
  padding-top: 24rpx;
  border-top: 1rpx solid #F3F4F6;
}

.stat-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 800;
  color: #20B2AA;
}

.stat-label {
  font-size: 22rpx;
  color: #9CA3AF;
  font-weight: 500;
}

/* ========== Section卡片 ========== */
.section-card {
  margin: 20rpx 24rpx;
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.section-title-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.section-icon {
  font-size: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2937;
}

/* 行程亮点 */
.highlight-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.highlight-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  background: #F9FAFB;
  border-radius: 16rpx;
}

.day-badge {
  min-width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  background: linear-gradient(135deg, #20B2AA 0%, #0D9488 100%);
  color: white;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.highlight-text {
  font-size: 26rpx;
  color: #374151;
  line-height: 1.5;
  flex: 1;
}

/* ========== 完整攻略内容区域 ========== */
.content-section {
  padding: 32rpx 24rpx;
}

.guide-content {
  font-size: 28rpx;
  line-height: 2;
  color: #374151;
}

/* towxml 内容样式微调 */
.guide-content image {
  max-width: 100%;
  border-radius: 12rpx;
  margin: 16rpx 0;
}

/* 无内容提示 */
.no-content-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0;
  gap: 16rpx;
}

.no-content-icon {
  font-size: 64rpx;
}

.no-content-text {
  font-size: 26rpx;
  color: #9CA3AF;
  text-align: center;
}

/* 攻略特色网格 */
.feature-grid {
  display: flex;
  justify-content: space-between;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}

.feature-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 40rpx;
  border-radius: 24rpx;
}

.fi-1 { background: #EFF6FF; }
.fi-2 { background: #FEF3C7; }
.fi-3 { background: #FDE8E8; }
.fi-4 { background: #D1FAE5; }

.feature-name {
  font-size: 22rpx;
  color: #6B7280;
  font-weight: 600;
}

/* ========== 操作按钮行 ========== */
.action-bar {
  display: flex;
  justify-content: space-around;
  padding: 24rpx 24rpx 0;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  background: none;
  border: none;
  padding: 12rpx 32rpx;
  line-height: 1.2;
}

.action-item::after {
  display: none;
}

.action-icon {
  font-size: 44rpx;
}

.action-label {
  font-size: 22rpx;
  color: #6B7280;
  font-weight: 500;
}

/* ========== 错误状态 ========== */
.error-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 240rpx 60rpx;
}

.error-emoji {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.error-msg {
  font-size: 28rpx;
  color: #9CA3AF;
  margin-bottom: 48rpx;
  text-align: center;
}

.retry-btn {
  background: linear-gradient(135deg, #20B2AA 0%, #0D9488 100%);
  color: white;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  border-radius: 40rpx;
  padding: 20rpx 64rpx;
  box-shadow: 0 8rpx 24rpx rgba(13, 148, 136, 0.3);
}

/* ========== 动画 ========== */
@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ========== 🔥 比价表格样式优化 ========== */
.guide-content table {
  width: 100%;
  border-collapse: collapse;
  margin: 24rpx 0;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.25);
}

.guide-content table thead {
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(10px);
}

.guide-content table th {
  padding: 24rpx 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: white;
  text-align: center;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.2);
}

.guide-content table td {
  padding: 28rpx 16rpx;
  font-size: 28rpx;
  color: white;
  text-align: center;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.guide-content table tbody tr:last-child td {
  border-bottom: none;
}

.guide-content table tbody tr:nth-child(1) {
  background: rgba(255, 215, 0, 0.15);  /* 推荐项高亮 */
}

.guide-content table a {
  color: #FFD700;
  font-weight: 600;
  text-decoration: none;
  padding: 12rpx 32rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  display: inline-block;
  transition: all 0.3s;
}

.guide-content blockquote {
  margin: 24rpx 0;
  padding: 20rpx 28rpx;
  background: linear-gradient(90deg, rgba(255, 215, 0, 0.1), rgba(255, 215, 0, 0.05));
  border-left: 6rpx solid #FFD700;
  border-radius: 8rpx;
  color: #1F2937;
  font-size: 26rpx;
  line-height: 1.8;
}

.guide-content blockquote strong {
  color: #D97706;
  font-weight: 600;
}
