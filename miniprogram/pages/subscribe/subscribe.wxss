/* 订阅页面样式 */

.subscribe-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #F0F9FF 0%, #FFFFFF 100%);
  padding: 40rpx 32rpx 80rpx;
}

/* ========== 头部 ========== */
.header {
  text-align: center;
  padding: 40rpx 0 60rpx;
}

.header .icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 24rpx;
}

.header .title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1F2937;
  margin-bottom: 16rpx;
}

.header .subtitle {
  font-size: 28rpx;
  color: #6B7280;
}

/* ========== 权益列表 ========== */
.benefits-section {
  margin-bottom: 48rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #374151;
  margin-bottom: 24rpx;
  padding-left: 8rpx;
}

.benefit-list {
  background: white;
  border-radius: 24rpx;
  padding: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.benefit-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 16rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.benefit-item:last-child {
  border-bottom: none;
}

.benefit-icon {
  font-size: 48rpx;
  margin-right: 24rpx;
  line-height: 1;
}

.benefit-content {
  flex: 1;
}

.benefit-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 8rpx;
}

.benefit-desc {
  font-size: 26rpx;
  color: #6B7280;
  line-height: 1.6;
}

/* ========== 示例预览 ========== */
.preview-section {
  margin-bottom: 48rpx;
}

.preview-card {
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.preview-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  text-align: center;
}

.preview-item {
  display: flex;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  line-height: 1.8;
}

.preview-item .label {
  opacity: 0.8;
  margin-right: 8rpx;
  white-space: nowrap;
}

.preview-item .value {
  flex: 1;
  font-weight: 500;
}

.preview-action {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
  text-align: center;
  font-size: 28rpx;
  color: #FFD700;
}

/* ========== 订阅状态 ========== */
.status-section {
  margin-bottom: 48rpx;
}

.status-card {
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.status-card.subscribed {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  color: white;
}

.status-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.status-text {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.status-desc {
  font-size: 26rpx;
  opacity: 0.8;
}

/* ========== 操作按钮 ========== */
.action-section {
  margin-bottom: 40rpx;
}

.subscribe-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.subscribe-btn.primary {
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.subscribe-btn.primary[disabled] {
  opacity: 0.6;
}

.subscribe-btn.secondary {
  background: white;
  color: #6B7280;
  border: 2rpx solid #E5E7EB;
}

/* ========== 提示文字 ========== */
.tips-section {
  padding: 0 16rpx;
}

.tip-item {
  font-size: 24rpx;
  color: #9CA3AF;
  line-height: 2;
  text-align: center;
}
