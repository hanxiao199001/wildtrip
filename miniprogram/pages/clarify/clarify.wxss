/* 需求澄清页面 - 精致版 */

.clarify-page {
  padding: 0 32rpx;
  padding-top: 24rpx;
  padding-bottom: 180rpx;
  background: linear-gradient(180deg, #E8F6F5 0%, #F2F4F7 30%, #F5F6F8 100%);
  min-height: 100vh;
  box-sizing: border-box;
}

/* ========== 顶部需求卡片 ========== */
.hero-card {
  position: relative;
  background: linear-gradient(135deg, #0D9488 0%, #14B8A6 40%, #2DD4BF 100%);
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 28rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(13, 148, 136, 0.25);
}

.hero-decoration {
  position: absolute;
  top: -40rpx;
  right: -30rpx;
  width: 180rpx;
  height: 180rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.hero-content {
  position: relative;
  z-index: 1;
}

.hero-label {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.hero-label-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.hero-label-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
  letter-spacing: 1rpx;
}

.hero-query {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.5;
  letter-spacing: 1rpx;
}

/* ========== 进度指示器 ========== */
.progress-section {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.progress-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.progress-left {
  display: flex;
  align-items: center;
}

.progress-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.progress-tip {
  font-size: 24rpx;
  color: #8C8C8C;
  font-weight: 500;
}

.progress-count {
  display: flex;
  align-items: baseline;
}

.progress-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #0D9488;
}

.progress-divider {
  font-size: 24rpx;
  color: #D1D5DB;
  margin: 0 4rpx;
  font-weight: 500;
}

.progress-total {
  font-size: 26rpx;
  font-weight: 600;
  color: #9CA3AF;
}

.progress-bar-bg {
  height: 8rpx;
  background: #F0F0F0;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #0D9488, #2DD4BF);
  border-radius: 4rpx;
  transition: width 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
  min-width: 0%;
}

/* ========== 问题列表 ========== */
.questions-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.question-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.question-card.answered {
  border-color: rgba(13, 148, 136, 0.15);
  box-shadow: 0 4rpx 20rpx rgba(13, 148, 136, 0.08);
}

/* ========== 问题头部 ========== */
.question-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.q-badge {
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
  background: linear-gradient(135deg, #E0F2F1, #E8F5F3);
  transition: all 0.3s ease;
}

.question-card.answered .q-badge {
  background: linear-gradient(135deg, #0D9488, #14B8A6);
}

.q-badge-num {
  font-size: 24rpx;
  font-weight: 700;
  color: #0D9488;
}

.q-badge-check {
  font-size: 24rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.q-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.q-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2937;
  flex: 1;
  letter-spacing: 0.5rpx;
}

.q-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  margin-left: 12rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.q-tag.required {
  color: #EF4444;
  background: rgba(239, 68, 68, 0.08);
}

.q-tag.optional {
  color: #9CA3AF;
  background: rgba(156, 163, 175, 0.1);
}

/* ========== 选项网格 ========== */
.options-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.option-item {
  position: relative;
  flex: 1;
  min-width: calc(50% - 8rpx);
  max-width: calc(50% - 8rpx);
  background: #F8FAFB;
  border: 2rpx solid #F0F0F0;
  border-radius: 18rpx;
  padding: 24rpx 16rpx 20rpx;
  text-align: center;
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  box-sizing: border-box;
  overflow: hidden;
}

.option-item:active {
  transform: scale(0.97);
}

.option-item.selected {
  background: linear-gradient(135deg, rgba(13, 148, 136, 0.06), rgba(45, 212, 191, 0.08));
  border-color: #0D9488;
  box-shadow: 0 4rpx 16rpx rgba(13, 148, 136, 0.12);
}

/* 选中角标 */
.option-check {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background: #0D9488;
  border-radius: 0 16rpx 0 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.check-icon {
  font-size: 20rpx;
  color: #FFFFFF;
  font-weight: 700;
}

.option-emoji {
  font-size: 48rpx;
  margin-bottom: 10rpx;
  line-height: 1.2;
}

.option-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.option-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #374151;
  line-height: 1.3;
}

.option-item.selected .option-name {
  color: #0D9488;
}

.option-sub {
  font-size: 20rpx;
  color: #9CA3AF;
  line-height: 1.3;
}

.option-item.selected .option-sub {
  color: #5EADA6;
}

/* ========== 底部操作栏 ========== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  box-shadow: 0 -2rpx 24rpx rgba(0, 0, 0, 0.06);
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
}

.bottom-bar-inner {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.btn-skip {
  width: 160rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  color: #6B7280;
  background: transparent;
  border: 2rpx solid #E5E7EB;
  border-radius: 44rpx;
  padding: 0;
  flex-shrink: 0;
}

.btn-skip::after {
  border: none;
}

.skip-text {
  font-weight: 500;
}

.btn-confirm {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
  background: linear-gradient(135deg, #0D9488, #14B8A6);
  border-radius: 44rpx;
  border: none;
  padding: 0;
  box-shadow: 0 6rpx 20rpx rgba(13, 148, 136, 0.3);
  transition: all 0.3s ease;
}

.btn-confirm::after {
  border: none;
}

.btn-confirm.disabled {
  background: linear-gradient(135deg, #CBD5E1, #94A3B8);
  box-shadow: none;
}

.btn-confirm.active {
  box-shadow: 0 8rpx 24rpx rgba(13, 148, 136, 0.35);
}

.btn-confirm-text {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.btn-confirm-badge {
  font-size: 22rpx;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.25);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.btn-confirm.disabled .btn-confirm-badge {
  background: rgba(255, 255, 255, 0.15);
}
