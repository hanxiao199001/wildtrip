/* 需求澄清页面样式 */

.clarify-page {
  padding: 24rpx 32rpx;
  padding-bottom: 200rpx;
  background: #F5F5F5;
  min-height: 100vh;
}

/* ========== 用户需求卡片 ========== */
.user-input-card {
  background: linear-gradient(135deg, #0D9488 0%, #20B2AA 50%, #5FCCC4 100%);
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}

.card-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 8rpx;
}

.card-query {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  line-height: 1.4;
}

/* ========== AI提示语 ========== */
.ai-prompt {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  margin-bottom: 16rpx;
}

.ai-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.ai-text {
  font-size: 26rpx;
  color: #666;
}

/* ========== 问题卡片 ========== */
.questions-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.question-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.question-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.q-number {
  font-size: 24rpx;
  font-weight: 700;
  color: #FFFFFF;
  background: var(--primary-color, #20B2AA);
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.q-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  flex: 1;
}

.q-required {
  font-size: 20rpx;
  color: #FF6B6B;
  background: rgba(255, 107, 107, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-left: 8rpx;
}

/* ========== 选项网格 ========== */
.options-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.option-card {
  flex: 1;
  min-width: calc(50% - 8rpx);
  max-width: calc(50% - 8rpx);
  background: #F8F9FA;
  border: 3rpx solid transparent;
  border-radius: 16rpx;
  padding: 20rpx 16rpx;
  text-align: center;
  transition: all 0.25s ease;
  box-sizing: border-box;
}

.option-card:active {
  transform: scale(0.96);
}

.option-card.selected {
  background: rgba(32, 178, 170, 0.08);
  border-color: var(--primary-color, #20B2AA);
  box-shadow: 0 4rpx 12rpx rgba(32, 178, 170, 0.15);
}

.option-icon {
  font-size: 44rpx;
  margin-bottom: 8rpx;
}

.option-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 4rpx;
}

.option-card.selected .option-label {
  color: var(--primary-color, #20B2AA);
}

.option-desc {
  font-size: 20rpx;
  color: #999;
  line-height: 1.3;
}

/* ========== 操作按钮 ========== */
.action-buttons {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.btn-skip {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  color: #666;
  background: #F0F0F0;
  border-radius: 44rpx;
  border: none;
  padding: 0;
}

.btn-skip::after {
  border: none;
}

.btn-primary {
  flex: 2;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: linear-gradient(135deg, #0D9488, #20B2AA);
  border-radius: 44rpx;
  border: none;
  padding: 0;
}

.btn-primary::after {
  border: none;
}

.btn-primary.btn-disabled {
  opacity: 0.5;
}
