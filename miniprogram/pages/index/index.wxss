/* 野游记首页样式 */

.index-page {
  padding: 0;
  padding-bottom: 32rpx;
}

/* ========== 头部Hero区域 ========== */
.header-hero {
  position: relative;
  padding: 8rpx 40rpx 36rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #0D9488 0%, #20B2AA 30%, #5FCCC4 60%, #A7F3D0 100%);
  z-index: 0;
}

.hero-bg::after {
  content: '';
  position: absolute;
  bottom: -2rpx;
  left: -4rpx;
  right: -4rpx;
  height: 50rpx;
  background: #F5F5F5;
  border-radius: 50rpx 50rpx 0 0;
}

.hero-content {
  position: relative;
  z-index: 1;
  text-align: center;
  padding: 0rpx 0 8rpx;
}

.logo-img {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 4rpx;
}

.slogan {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 600;
}

/* ========== 搜索区域（嵌入Hero） ========== */
.search-section {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 20rpx;
}

.search-input {
  width: 100%;
  min-height: 200rpx;
  max-height: 280rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  font-size: 30rpx;
  color: #FFFFFF;
  box-sizing: border-box;
  backdrop-filter: blur(10px);
}

.search-btn {
  width: 60%;
  margin: 0 auto;
  height: 80rpx;
  line-height: 80rpx;
  background: #FFFFFF;
  color: #0D9488;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 40rpx;
  padding: 0;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.search-btn[disabled] {
  opacity: 0.5;
  background: rgba(255, 255, 255, 0.6);
}

/* ========== 特性标签（一行紧凑） ========== */
.features {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin-top: 16rpx;
  margin-bottom: 40rpx;
}

.feature-tag {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.15);
  padding: 16rpx 24rpx;
  border-radius: 20rpx;
  backdrop-filter: blur(10px);
}

/* ========== 精选攻略 ========== */
.featured-section {
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 0 40rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.section-subtitle {
  font-size: 22rpx;
  color: #999;
}

.featured-scroll {
  width: 100%;
  white-space: nowrap;
}

.featured-list {
  display: inline-flex;
  padding: 0 40rpx 8rpx;
  gap: 20rpx;
}

.featured-card {
  display: inline-block;
  width: 280rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  flex-shrink: 0;
}

.featured-card:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.featured-cover {
  position: relative;
  width: 100%;
  height: 180rpx;
  overflow: hidden;
}

.featured-img {
  width: 100%;
  height: 100%;
}

.featured-category {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  background: rgba(32, 178, 170, 0.9);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 500;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
}

.featured-info {
  padding: 16rpx;
  white-space: normal;
}

.featured-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}

.featured-meta {
  font-size: 22rpx;
  color: #20B2AA;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.featured-stats {
  font-size: 20rpx;
  color: #999;
  display: flex;
  gap: 12rpx;
}

.stat-views,
.stat-likes {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
}

/* ========== 返现横幅 ========== */
.cashback-banner {
  display: flex;
  align-items: center;
  margin: 0 40rpx;
  padding: 24rpx 32rpx;
  background: linear-gradient(135deg, rgba(32, 178, 170, 0.1) 0%, rgba(95, 204, 196, 0.1) 100%);
  border: 2rpx solid var(--primary-color);
  transition: all 0.3s ease;
}

.cashback-banner:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-card);
}

.cashback-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.cashback-content {
  flex: 1;
}

.cashback-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary-color);
  margin-bottom: 4rpx;
}

.cashback-desc {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.cashback-arrow {
  font-size: 40rpx;
  color: var(--primary-color);
  font-weight: 600;
}
