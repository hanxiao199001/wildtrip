/* pages/guide/detail.wxss */

.container {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 加载中 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #07c160;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #999;
}

/* 攻略内容 */
.guide-content {
  padding: 0 0 120rpx;
}

.guide-header {
  background: white;
  padding: 40rpx 30rpx;
}

.guide-title {
  display: block;
  font-size: 38rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.5;
}

.guide-meta {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #999;
}

.guide-type {
  padding: 6rpx 16rpx;
  margin-right: 20rpx;
  background: #07c160;
  color: white;
  border-radius: 8rpx;
}

.guide-date {
  color: #999;
}

.guide-body {
  margin-top: 20rpx;
  background: white;
  padding: 30rpx;
}

/* 预览模式 */
.preview-mode {
  position: relative;
  min-height: 600rpx;
}

.preview-content {
  filter: blur(3rpx);
  opacity: 0.5;
}

/* 解锁遮罩 */
.unlock-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.95);
}

.unlock-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
  background: white;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.1);
  width: 600rpx;
}

.lock-icon {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 30rpx;
}

.unlock-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.unlock-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 40rpx;
  text-align: center;
  line-height: 1.5;
}

.price-box {
  display: flex;
  align-items: baseline;
  margin-bottom: 40rpx;
}

.price-symbol {
  font-size: 40rpx;
  color: #ff6b6b;
  font-weight: bold;
}

.price-value {
  font-size: 80rpx;
  color: #ff6b6b;
  font-weight: bold;
  margin: 0 10rpx;
}

.price-desc {
  font-size: 24rpx;
  color: #999;
  margin-left: 10rpx;
}

.unlock-btn {
  width: 500rpx;
  height: 90rpx;
  line-height: 90rpx;
  background: linear-gradient(135deg, #07c160 0%, #05a350 100%);
  color: white;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 45rpx;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(7, 193, 96, 0.3);
}

.unlock-btn::after {
  border: none;
}

.payment-tips {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 30rpx;
  gap: 12rpx;
}

.tip-item {
  font-size: 24rpx;
  color: #999;
}

/* 完整内容 */
.full-content {
  position: relative;
}

.unlocked-badge {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 20rpx;
  margin-bottom: 30rpx;
  background: #f0f9ff;
  border: 2rpx solid #07c160;
  border-radius: 40rpx;
  font-size: 24rpx;
  color: #07c160;
}

.check-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

/* Rich Text 样式 */
.full-content rich-text,
.preview-content rich-text {
  font-size: 30rpx;
  line-height: 1.8;
  color: #333;
}
