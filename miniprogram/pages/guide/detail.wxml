<!--pages/guide/detail.wxml-->
<view class="container">
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 攻略内容 -->
  <view wx:else class="guide-content">
    
    <!-- 攻略标题 -->
    <view class="guide-header">
      <text class="guide-title">{{guideData.title}}</text>
      <view class="guide-meta">
        <text class="guide-type">{{guideType === 'history' ? '人文历史' : '旅行攻略'}}</text>
        <text class="guide-date">{{guideData.createdAt}}</text>
      </view>
    </view>

    <!-- 攻略预览内容 -->
    <view class="guide-body">
      <view wx:if="{{!unlocked}}" class="preview-mode">
        <!-- 预览部分 (前30%) -->
        <view class="preview-content">
          <rich-text nodes="{{guideData.preview}}"></rich-text>
        </view>

        <!-- 遮罩层 -->
        <view class="unlock-mask">
          <view class="unlock-card">
            <image class="lock-icon" src="/images/lock.png" mode="aspectFit"></image>
            <text class="unlock-title">解锁完整攻略</text>
            <text class="unlock-desc">查看完整的行程规划、景点介绍、美食推荐</text>
            
            <view class="price-box">
              <text class="price-symbol">¥</text>
              <text class="price-value">{{price}}</text>
              <text class="price-desc">一次购买,永久有效</text>
            </view>

            <button 
              class="unlock-btn" 
              bindtap="onUnlockTap"
              loading="{{paying}}"
              disabled="{{paying}}"
            >
              {{paying ? '支付中...' : '立即解锁'}}
            </button>

            <view class="payment-tips">
              <text class="tip-item">✓ 微信支付,安全便捷</text>
              <text class="tip-item">✓ 一次购买,永久查看</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 完整内容 (已解锁) -->
      <view wx:else class="full-content">
        <view class="unlocked-badge">
          <image class="check-icon" src="/images/check.png" mode="aspectFit"></image>
          <text>已解锁</text>
        </view>
        
        <rich-text nodes="{{guideData.content}}"></rich-text>
      </view>
    </view>

  </view>
</view>
