<!--攻略结果页面-->
<view class="page-container result-page">
  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <view class="loading-text">加载中...</view>
  </view>

  <!-- 结果内容 -->
  <view wx:if="{{!loading && result}}">
    <!-- 返现横幅 -->
    <view class="cashback-banner">
      <view class="cashback-icon">💰</view>
      <view class="cashback-content">
        <view class="cashback-title">预计返现 ¥{{estimatedCashback}}</view>
        <view class="cashback-desc">预订后7-30天到账</view>
      </view>
    </view>

    <!-- 统计信息 -->
    <view class="stats-bar">
      <view class="stat-item">
        <view class="stat-icon">🏨</view>
        <view class="stat-value">{{stats.hotels_count}}</view>
        <view class="stat-label">家酒店</view>
      </view>
      <view class="stat-item">
        <view class="stat-icon">🍜</view>
        <view class="stat-value">{{stats.restaurants_count}}</view>
        <view class="stat-label">家餐厅</view>
      </view>
      <view class="stat-item">
        <view class="stat-icon">🎫</view>
        <view class="stat-value">{{stats.tickets_count}}</view>
        <view class="stat-label">个景点</view>
      </view>
    </view>

    <!-- 攻略内容（🔥 支持Markdown图片） -->
    <view class="content-card card">
      <towxml nodes="{{article}}" />
    </view>

    <!-- 🔥 快速预订区域 -->
    <view class="quick-booking card" wx:if="{{links && links.length > 0}}">
      <view class="section-title">🔥 快速预订（返现50%）</view>
      
      <!-- 酒店按钮（每家酒店：美团 + 飞猪比价） -->
      <view class="link-group" wx:if="{{hotelLinks.length > 0}}">
        <view class="group-label">🏨 酒店预订 · 两平台比价</view>
        <view class="hotel-pair-list">
          <block wx:for="{{hotelLinks}}" wx:key="index">
            <view class="hotel-pair-item" wx:if="{{item.platform === 'meituan'}}">
              <view class="hotel-name-row">{{item.name}}</view>
              <view class="hotel-btn-row">
                <navigator
                  url="/pages/webview/webview?url={{item.url}}&title={{item.name}}-美团"
                  class="link-btn hotel-btn meituan-btn"
                >🟡 美团订</navigator>
                <!-- 飞猪按钮紧跟在下一个元素（platform=feizhu）-->
                <navigator
                  wx:if="{{hotelLinks[index+1] && hotelLinks[index+1].platform === 'feizhu'}}"
                  url="/pages/webview/webview?url={{hotelLinks[index+1].url}}&title={{item.name}}-飞猪"
                  class="link-btn hotel-btn feizhu-btn"
                >🟠 飞猪比价</navigator>
              </view>
            </view>
          </block>
        </view>
      </view>

      <!-- 餐厅按钮 -->
      <view class="link-group" wx:if="{{restaurantLinks.length > 0}}">
        <view class="group-label">🍜 美食团购</view>
        <view class="link-buttons">
          <navigator 
            wx:for="{{restaurantLinks}}" 
            wx:key="name"
            url="/pages/webview/webview?url={{item.url}}&title={{item.name}}"
            class="link-btn food-btn"
          >
            {{item.name}}
          </navigator>
        </view>
      </view>

      <!-- 门票按钮 -->
      <view class="link-group" wx:if="{{ticketLinks.length > 0}}">
        <view class="group-label">🎫 门票购买</view>
        <view class="link-buttons">
          <navigator 
            wx:for="{{ticketLinks}}" 
            wx:key="name"
            url="/pages/webview/webview?url={{item.url}}&title={{item.name}}"
            class="link-btn ticket-btn"
          >
            {{item.name}}
          </navigator>
        </view>
      </view>

      <view class="cashback-tip">💡 通过上方链接预订，返现50%给你！</view>
    </view>

    <!-- 操作按钮 -->
    <view class="actions">
      <!-- 第一行：主要操作 -->
      <view class="action-row">
        <button class="btn-secondary" bindtap="onCopy">📋 复制</button>
        <button class="btn-secondary" bindtap="onToggleFavorite">
          {{isFavorited ? '★ 已收藏' : '☆ 收藏'}}
        </button>
        <button class="btn-primary" bindtap="onShare">✈️ 分享</button>
      </view>
      
      <!-- 第二行：高级操作 -->
      <view class="action-row action-row-secondary">
        <button class="btn-link" bindtap="onGenerateShareLink">🔗 复制链接</button>
        <button class="btn-danger" bindtap="onDelete">🗑️ 删除</button>
      </view>
    </view>
  </view>

  <!-- 错误状态 -->
  <view class="error" wx:if="{{!loading && error}}">
    <view class="error-icon">❌</view>
    <view class="error-text">{{error}}</view>
    <button class="btn-primary" bindtap="onRetry">重新生成</button>
  </view>
</view>
