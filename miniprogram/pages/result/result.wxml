<!--攻略结果页面-->
<view class="page-container result-page {{isUnlocked ? 'has-bottom-bar' : ''}}">
  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <view class="loading-text">加载中...</view>
  </view>

  <!-- 结果内容 -->
  <view wx:if="{{!loading && result}}">
    <!-- 返现横幅 -->
    <view class="cashback-banner">
      <view class="cashback-icon">💰</view>
      <view class="cashback-content">
        <view class="cashback-title">预计立省 ¥{{estimatedCashback}}</view>
        <view class="cashback-desc">预订即享优惠价</view>
      </view>
    </view>

    <!-- 统计信息 -->
    <view class="stats-bar">
      <view class="stat-item">
        <view class="stat-icon">🏨</view>
        <view class="stat-value">{{stats.hotels_count}}</view>
        <view class="stat-label">家酒店</view>
      </view>
      <view class="stat-item">
        <view class="stat-icon">🍜</view>
        <view class="stat-value">{{stats.restaurants_count}}</view>
        <view class="stat-label">家餐厅</view>
      </view>
      <view class="stat-item">
        <view class="stat-icon">🎫</view>
        <view class="stat-value">{{stats.tickets_count}}</view>
        <view class="stat-label">个景点</view>
      </view>
    </view>

    <!-- 已解锁：完整攻略内容（🔥 支持Markdown图片） -->
    <view class="content-card card" wx:if="{{isUnlocked}}">
      <towxml nodes="{{article}}" />
    </view>

    <!-- 🔥 未解锁：显示前30%内容 + 底部渐变遮罩 -->
    <view class="content-card card content-preview-wrap" wx:if="{{!isUnlocked && !checkingUnlock}}">
      <towxml nodes="{{articlePreview}}" />
      <view class="content-preview-fade"></view>
    </view>

    <!-- 解锁提示卡片 -->
    <view class="unlock-card card" wx:if="{{!isUnlocked && !checkingUnlock}}">
      <view class="unlock-card-header">
        <text class="unlock-icon-big">🔒</text>
        <text class="unlock-title">解锁完整攻略</text>
      </view>
      <view class="unlock-benefits">
        <view class="unlock-benefit-item">✅ 完整行程时间表（精确到每小时）</view>
        <view class="unlock-benefit-item">✅ 餐厅名称 + 地址 + 推荐菜品</view>
        <view class="unlock-benefit-item">✅ 景点门票优惠渠道</view>
        <view class="unlock-benefit-item">✅ 雨天备选方案</view>
      </view>
      <view class="unlock-price-row">
        <text class="unlock-price-symbol">¥</text>
        <text class="unlock-price-amount">4.9</text>
        <text class="unlock-price-desc">一次付费 · 永久查看</text>
      </view>
      <button class="unlock-pay-btn" bindtap="onUnlockGuide">💎 立即解锁</button>
    </view>

    <!-- 正在检查解锁状态 -->
    <view class="content-card card" wx:if="{{checkingUnlock}}" style="text-align:center;padding:60rpx 0;">
      <view class="loading-spinner" style="margin:0 auto 20rpx;width:48rpx;height:48rpx;border-width:4rpx;"></view>
      <text style="color:#9CA3AF;font-size:26rpx;">正在检查解锁状态...</text>
    </view>

    <!-- 🔥 快速预订区域（聚推客联盟 - 跳转美团小程序）解锁后才显示 -->
    <view class="quick-booking card" wx:if="{{isUnlocked && links && links.length > 0}}">
      <view class="section-title">🔥 快速预订（立省50%）</view>

      <!-- 美团小程序跳转状态提示 -->
      <view class="miniprogram-tip" wx:if="{{meituanMiniprogram && meituanMiniprogram.enabled}}">
        <text class="tip-icon">✅</text>
        <text class="tip-text">点击直达美团小程序，下单立省</text>
      </view>

      <!-- 酒店按钮 -->
      <view class="link-group" wx:if="{{hotelLinks.length > 0}}">
        <view class="group-label">🏨 酒店预订</view>
        <view class="link-buttons">
          <view
            wx:for="{{hotelLinks}}"
            wx:key="name"
            class="link-btn hotel-btn"
            bindtap="onJumpMeituan"
            data-name="{{item.name}}"
            data-url="{{item.url}}"
            data-type="hotel"
          >
            {{item.name}}
          </view>
        </view>
      </view>

      <!-- 餐厅按钮 -->
      <view class="link-group" wx:if="{{restaurantLinks.length > 0}}">
        <view class="group-label">🍜 美食团购</view>
        <view class="link-buttons">
          <view
            wx:for="{{restaurantLinks}}"
            wx:key="name"
            class="link-btn food-btn"
            bindtap="onJumpMeituan"
            data-name="{{item.name}}"
            data-url="{{item.url}}"
            data-type="restaurant"
          >
            {{item.name}}
          </view>
        </view>
      </view>

      <!-- 门票按钮 -->
      <view class="link-group" wx:if="{{ticketLinks.length > 0}}">
        <view class="group-label">🎫 门票购买</view>
        <view class="link-buttons">
          <view
            wx:for="{{ticketLinks}}"
            wx:key="name"
            class="link-btn ticket-btn"
            bindtap="onJumpMeituan"
            data-name="{{item.name}}"
            data-url="{{item.url}}"
            data-type="ticket"
          >
            {{item.name}}
          </view>
        </view>
      </view>

      <view class="cashback-tip">💡 通过上方链接预订，立省50%！</view>
    </view>

    <!-- 相关推荐 -->
    <view class="related-section" wx:if="{{relatedGuides.length > 0}}">
      <view class="related-header">
        <view class="related-title">相关推荐</view>
        <view class="related-subtitle">你可能还感兴趣</view>
      </view>
      <view class="related-list">
        <view
          class="related-card"
          wx:for="{{relatedGuides}}"
          wx:key="slug"
          bindtap="onRelatedTap"
          data-item="{{item}}"
        >
          <image
            class="related-cover"
            src="{{item.cover_image}}"
            mode="aspectFill"
            lazy-load="true"
          />
          <view class="related-info">
            <view class="related-name">{{item.title}}</view>
            <view class="related-meta">
              <text wx:if="{{item.days}}">{{item.days}}天</text>
              <text wx:if="{{item.budget}}"> · ¥{{item.budget}}</text>
              <text wx:if="{{item.category}}"> · {{item.category}}</text>
            </view>
            <view class="related-stats-row">
              <text>👀 {{item.views}}</text>
              <text>❤️ {{item.likes}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 操作按钮（仅解锁后显示，避免与解锁卡片重叠） -->
    <view class="actions" wx:if="{{isUnlocked}}">
      <!-- 第一行：主要操作 -->
      <view class="action-row">
        <button class="btn-secondary" bindtap="onCopy">📋 复制</button>
        <button class="btn-secondary" bindtap="onToggleFavorite">
          {{isFavorited ? '★ 已收藏' : '☆ 收藏'}}
        </button>
        <button class="btn-primary" bindtap="showSharePoster">✈️ 分享</button>
      </view>

      <!-- 第二行：高级操作 -->
      <view class="action-row action-row-secondary">
        <button class="btn-link" bindtap="onGenerateShareLink">🔗 复制链接</button>
        <button class="btn-danger" bindtap="onDelete">🗑️ 删除</button>
      </view>
    </view>

    <!-- 分享海报组件 -->
    <share-poster
      visible="{{showPoster}}"
      guideData="{{posterData}}"
      bind:close="onClosePoster"
    />
  </view>

  <!-- 错误状态 -->
  <view class="error" wx:if="{{!loading && error}}">
    <view class="error-icon">❌</view>
    <view class="error-text">{{error}}</view>
    <button class="btn-primary" bindtap="onRetry">重新生成</button>
  </view>
</view>
