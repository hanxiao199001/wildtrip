/* pages/user/unlocked.wxss */

.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx 0 120rpx;
}

/* 统计卡片 */
.stats-card {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin: 20rpx 30rpx;
  padding: 50rpx 0;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(102, 126, 234, 0.3);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 48rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.stat-divider {
  width: 2rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.3);
}

/* 加载中 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #999;
}

/* 攻略列表 */
.guide-list {
  margin: 0 30rpx;
}

.guide-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  margin-bottom: 20rpx;
  background: white;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.guide-info {
  flex: 1;
  margin-right: 20rpx;
}

.guide-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.guide-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  line-height: 1.4;
}

.guide-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.guide-type {
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  color: white;
  border-radius: 8rpx;
}

.guide-type.travel {
  background: #07c160;
}

.guide-type.history {
  background: #ff6b6b;
}

.guide-date {
  font-size: 24rpx;
  color: #999;
}

.guide-action {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.guide-price {
  font-size: 32rpx;
  font-weight: bold;
  color: #667eea;
  margin-bottom: 8rpx;
}

.arrow-icon {
  font-size: 48rpx;
  color: #ddd;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 60rpx;
}

.go-explore-btn {
  width: 300rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  font-size: 28rpx;
  border-radius: 40rpx;
  border: none;
}

.go-explore-btn::after {
  border: none;
}
