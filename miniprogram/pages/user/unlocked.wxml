<!--pages/user/unlocked.wxml-->
<view class="container">

  <!-- 统计卡片 -->
  <view class="stats-card">
    <view class="stat-item">
      <text class="stat-value">{{totalCount}}</text>
      <text class="stat-label">我的攻略</text>
    </view>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 攻略列表 -->
  <view wx:elif="{{guides.length > 0}}" class="guide-list">
    <view
      wx:for="{{guides}}"
      wx:key="guide_id"
      class="guide-item"
      data-slug="{{item.slug}}"
      data-title="{{item.query}}"
      bindtap="onGuideTap"
    >
      <view class="guide-info">
        <view class="guide-title-row">
          <text class="guide-title">{{item.query}}</text>
        </view>

        <view class="guide-meta">
          <view class="guide-type {{item.mode === 'history' ? 'history' : 'travel'}}">
            {{item.typeLabel}}
          </view>
          <text class="guide-date">{{item.date}}</text>
        </view>
      </view>

      <view class="guide-action">
        <view class="arrow-icon">›</view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:else class="empty-state">
    <image class="empty-icon" src="/images/empty.png" mode="aspectFit"></image>
    <text class="empty-text">还没有生成过攻略</text>
    <button class="go-explore-btn" bindtap="onExplore">去探索</button>
  </view>

</view>
