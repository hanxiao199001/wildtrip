/* components/share-poster/share-poster.wxss */

.poster-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  animation: fadeIn 0.3s ease;
}

.modal-content {
  position: relative;
  z-index: 10;
  background: white;
  border-radius: 24rpx;
  padding: 40rpx;
  max-width: 90%;
  max-height: 90%;
  animation: slideUp 0.4s ease;
}

/* 生成中状态 */
.generating {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx;
}

.loading-icon {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 40rpx;
}

.spinner {
  width: 100%;
  height: 100%;
  border: 8rpx solid #F0F0F0;
  border-top-color: #FF6B35;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loading-text {
  font-size: 28rpx;
  color: #666666;
}

/* 海报预览 */
.poster-preview {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.poster-image {
  width: 100%;
  max-width: 600rpx;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
  width: 100%;
}

.btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.btn-save {
  background: linear-gradient(135deg, #FF6B35 0%, #F7931E 100%);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.4);
}

.btn-save:active {
  transform: scale(0.96);
}

.btn-close {
  background: #F5F5F5;
  color: #666666;
}

.btn-close:active {
  background: #E0E0E0;
}

.tip {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #999999;
  text-align: center;
}

/* 隐藏的 Canvas */
.hidden-canvas {
  position: fixed;
  top: -9999px;
  left: -9999px;
  width: 750px;
  height: 1334px;
}

/* 动画 */
@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes slideUp {
  from {
    transform: translateY(100rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
